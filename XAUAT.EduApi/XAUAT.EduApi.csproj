<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DotNetEnv" Version="3.2.0" />
        <PackageReference Include="Flurl.Http" Version="4.0.2" />
        <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
        <PackageReference Include="MailKit" Version="4.16.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
        <PackageReference Include="NpgsqlDataProtection" Version="2.0.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.14.7" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="StackExchange.Redis" Version="2.12.14" />
    </ItemGroup>

    <!--
      安全修复：MimeKit 4.16.0 传递依赖 System.Security.Cryptography.Pkcs 10.0.0，
      而 10.0.0–10.0.12 命中 GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7（均由 10.0.13 修复）。
      显式引用新版本覆盖传递解析，别删。
    -->
    <ItemGroup>
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\EduApi.Data\EduApi.Data.csproj" />
    </ItemGroup>

    <!--
      登录子系统（Login/）整块是 internal 的：它是从 XAUAT.LoginApi 整段搬进来的内聚子系统，
      不是本项目的 API 面（对外契约是 Controllers/V1 上的那几个控制器）。
      测试要直接驱动 SsoAuthService / BanService / XauatHtmlParser 这些内部类型，
      因此按 LoginApi 的既有做法开这个后门。
    -->
    <ItemGroup>
      <InternalsVisibleTo Include="XAUAT.EduApi.Tests" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Repos\" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="TestFixtures/**/*.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
