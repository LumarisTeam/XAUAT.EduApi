ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL 连接字符串；留空时默认回退到 SQLite(Data.db)
SQL=

# Redis 连接字符串；留空时表示不启用 Redis
REDIS=localhost:6379

SERVICE_NAME=XAUAT.EduApi
SERVICE_INSTANCE_ID=

PROMETHEUS_ENABLED=true
LOGGING_ENABLED=true

ELECTRICITY_SUBSCRIPTION_SCAN_INTERVAL_MINUTES=15
ELECTRICITY_SUBSCRIPTION_NOTIFICATION_COOLDOWN_MINUTES=720
ELECTRICITY_SUBSCRIPTION_BATCH_SIZE=50

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=XAUAT EduApi

# 校园卡支付：EduApi 已不再内置支付实现，全部转发到独立的 XAUAT.PaymentAPI。
# 这是必需项——缺失时 EduApi 启动即失败（不会回退到本地实现）。
# 同机 docker compose 部署填服务名；跨主机部署填实际可达地址。
PAYMENT_API_BASE_URL=http://xauat-paymentapi:8080

# 登录：与支付不同，这里**保留回退**。
#   留空   = 维持现状，EduApi 直接打 Flask 的 https://schedule.xauat.site
#   填了   = 转发到 XAUAT.LoginApi（同机 compose 填服务名；跨主机填实际可达地址）
# 改这一个变量就能在两个实现间来回切，回滚不需要回退镜像。
LOGIN_API_BASE_URL=

# 管理端接口令牌。管两类端点：
#   /v1/map/**        —— 地图 POI 的增删改（原本就只有这一处）
#   /v1/login-ops/**  —— 登录服务的运维数据（活跃用户数、封禁日志、解封）
# 应与管理端登录用的那个 Token（Luminous 的 LUMINOUS_AUTH_ADMIN_TOKEN）同值，
# 这样 lumaris_admin 现有的 Authorization: Bearer 头不用改一行。
# **留空 = 上述端点一律 401**（服务是 fail-closed 的，不会静默放开）。
MAP_ADMIN_TOKEN=

TEST_ACCOUNT_ENABLED=false
TEST_ACCOUNT_USERNAME=frontend-test
TEST_ACCOUNT_PASSWORD=frontend-test-password
TEST_ACCOUNT_STUDENT_ID=20239999
TEST_ACCOUNT_COOKIE_MARKER=frontend-test-marker
TEST_ACCOUNT_FIXTURE_PATH=TestFixtures

GITEE_ACCESS_TOKEN=
START=
END=
